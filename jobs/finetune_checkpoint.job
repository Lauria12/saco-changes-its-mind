#!/bin/bash
#SBATCH --job-name=saco_finetune
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=18
#SBATCH --time=03:00:00
#SBATCH --account=YOUR_SLURM_ACCOUNT
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Fine-tunes one missing (arch, dataset) CIFAR checkpoint. Submit with e.g.:
#   sbatch --export=ARCH=vit_l16,DATASET=cifar10   jobs/finetune_checkpoint.job
#   sbatch --export=ARCH=deit_b16,DATASET=cifar10  jobs/finetune_checkpoint.job
#   sbatch --export=ARCH=deit_b16,DATASET=cifar100 jobs/finetune_checkpoint.job
#
# Requires jobs/prepare_data.job to have already staged CIFAR-10/100 under data/.
# Submit from the repository root, same as run_experiment.job.
#
# --time=03:00:00 is a rough first-pass estimate (5 epochs, ~50k train images,
# 1 A100, bf16) -- tighten after the first real run's timing is known.
set -euo pipefail

: "${ARCH:?set via sbatch --export=ARCH=vit_l16|deit_b16}"
: "${DATASET:?set via sbatch --export=DATASET=cifar10|cifar100}"
: "${EPOCHS:=5}"
: "${DATA_ROOT:=$SLURM_SUBMIT_DIR/data}"
: "${CHECKPOINT_DIR:=$SLURM_SUBMIT_DIR/checkpoints}"

module purge
module load 2024
module load Anaconda3/2024.06-1   # <-- verify with `module avail Anaconda3`
source activate saco

# See jobs/run_experiment.job for why this is required (conda doesn't put its own
# lib/ on LD_LIBRARY_PATH by default; torch/torchvision need the newer libstdc++
# conda-forge's libstdcxx-ng provides there, not the cluster's older system one).
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"

# Fail loud, not silent: this job requested --gpus=1, so torch.cuda.is_available()
# must be True. Fine-tuning on CPU would silently take days instead of ~1 hour.
python -c "import torch, sys; sys.exit(0 if torch.cuda.is_available() else 1)" \
  || { echo "FATAL: torch.cuda.is_available() is False in a --gpus=1 job -- refusing to silently run on CPU." >&2; exit 1; }

cd "$SLURM_SUBMIT_DIR/src"

export HF_HOME="$SLURM_SUBMIT_DIR/.hf_cache"

srun python finetune_cifar_checkpoint.py \
  --arch "$ARCH" --dataset "$DATASET" \
  --data-root "$DATA_ROOT" --output-dir "$CHECKPOINT_DIR" \
  --epochs "$EPOCHS"
