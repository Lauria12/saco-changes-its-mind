#!/bin/bash
#SBATCH --job-name=saco_prepare_data
#SBATCH --partition=staging
#SBATCH --time=01:00:00
#SBATCH --account=YOUR_SLURM_ACCOUNT
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Pre-downloads model weights (torchvision/timm/HF Hub) and datasets
# (Imagenette/CIFAR) so the GPU jobs never need internet. ImageNet is NOT handled
# here -- there's no stable auto-download; stage it yourself and point
# --data-root at it.
#
# IMPORTANT: submit from the repository root, e.g. `sbatch jobs/prepare_data.job`.
set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1   # <-- verify with `module avail Anaconda3`
source activate saco

# See jobs/run_experiment.job for why this is required (conda doesn't put its own
# lib/ on LD_LIBRARY_PATH by default; torch/torchvision need the newer libstdc++
# conda-forge's libstdcxx-ng provides there, not the cluster's older system one).
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"

cd "$SLURM_SUBMIT_DIR/src"

export HF_HOME="$SLURM_SUBMIT_DIR/.hf_cache"

python prepare_data.py \
  --datasets imagenette cifar10 cifar100 \
  --arches vit_b16 vit_l16 deit_b16 \
  --data-root "$SLURM_SUBMIT_DIR/data"
