#!/bin/bash
#SBATCH --job-name=saco_install
#SBATCH --partition=staging
#SBATCH --time=02:00:00
#SBATCH --account=YOUR_SLURM_ACCOUNT
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Builds the conda env. Runs on `staging` (has internet, no GPU) because:
#   1. Package downloads need internet, which gpu_* compute nodes are not
#      guaranteed to have.
#   2. Installs commonly take 20-30 min, which the login node kills after ~15 min
#      of interactive use -- this must run as a batch job.
#
# Verify the exact module names before running -- SURF updates the toolchain
# yearly (this was written against the "2024"/"2025" software stack):
#   module avail Anaconda3
#   module avail Miniconda3
#
# IMPORTANT: submit from the repository root, e.g. `sbatch jobs/install_env.job`.
set -euo pipefail

module purge
module load 2024
module load Anaconda3/2024.06-1   # <-- verify with `module avail Anaconda3`

cd "$SLURM_SUBMIT_DIR"

# The classic conda solver can take a very long time on this dependency set --
# if this job is timing out, install libmamba (`conda install -n base conda-libmamba-solver`)
# and add `--solver=libmamba` to both commands below.
conda env create -f environment/environment.yml || \
  conda env update -f environment/environment.yml --prune

echo "Environment ready. Activate with: conda activate saco"
